# Switchboard environment. Copy to .env and change only what differs on your machine:
#
#   cp .env.example .env
#
# Every value below is the default the server already uses, so the app also runs
# with no .env at all. Nothing here is a real secret. Real variables in the
# shell override this file. The check (npm run check) sets its own PORT.
#
# Read by: scaffold/server/src/config/env.ts (validated with zod at boot: a bad
# value stops the server with a clear message) and scaffold/web/vite.config.ts.

# --- your app ---------------------------------------------------------------
# Port the API server listens on. The check overrides it (4001, 4002, ...).
PORT=4000
# Where the browser is sent after login/logout (the React app).
WEB_ORIGIN=http://localhost:5173
# Protects /__grader/* (header x-grader-token). Must match what the check sends.
GRADER_TOKEN=grader-dev-token
# development | production | test. The check runs production; behaviour is the same.
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- data stores (real, from docker compose) ---------------------------------
MONGO_URL=mongodb://localhost:27017/switchboard
REDIS_URL=redis://localhost:6379
# Optional: only for message search (npm run up:search).
ELASTICSEARCH_URL=http://localhost:9200

# --- Pigeon, the messaging provider (see PIGEON.md) -------------------------
PIGEON_URL=http://localhost:4010
# HMAC secret for x-pigeon-signature on incoming webhooks.
PIGEON_WEBHOOK_SECRET=whsec_pigeon_dev
# One API key per workspace. The workspace id is derived from the name:
# PIGEON_KEY_WS_ACME -> ws_acme. Add PIGEON_KEY_WS_<NAME> to add a workspace;
# a workspace without a key does not exist (grader reply -> 4xx).
PIGEON_KEY_WS_ACME=pk_acme_7d1f0a
PIGEON_KEY_WS_GLOBEX=pk_globex_c93b22

# --- Mock identity provider (OpenID Connect) ---------------------------------
OIDC_ISSUER=http://localhost:4020
OIDC_CLIENT_ID=switchboard-web
OIDC_CLIENT_SECRET=dev-secret-not-for-production
# Registered redirect URIs: http://localhost:{3000,4000,5173}/auth/callback
# Keep :4000 for the check. Cookies are per host (not per port), so the session
# set here also reaches the React app on :5173. Using https:// here also turns
# on the Secure flag for session cookies.
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback

# --- web dev server (scaffold/web, Vite) -------------------------------------
# Where Vite proxies /api, /auth, /healthz and /ws. Defaults to http://localhost:$PORT.
# API_TARGET=http://localhost:4000

# --- Paybox, the payment provider, bonus track only (see PAYBOX.md) ---------
# Not used by the app yet (billing bonus is cut).
PAYBOX_URL=http://localhost:4030
PAYBOX_SECRET_KEY=sk_test_paybox_51c0de
PAYBOX_PUBLISHABLE_KEY=pk_test_paybox_9a7b3e
PAYBOX_WEBHOOK_SECRET=whsec_paybox_dev
